# Nextcloud connection
NC_URL=https://cloud.example.com
NC_USERNAME=your-username
# Create one in Nextcloud: Settings -> Security -> Devices & sessions
NC_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token that MCP clients must send (choose a long random string,
# e.g.: openssl rand -hex 32)
MCP_TOKEN=

# Server binding
MCP_HOST=127.0.0.1
MCP_PORT=8010

# Optional tuning
# NC_TIMEOUT=30
# NC_DEFAULT_TZ=Europe/Berlin
# NC_TALK_ROOMS_PATH=/ocs/v2.php/apps/spreed/api/v4/rooms
